# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Get these from: Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Public Supabase project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anonymous (public) key — used by the browser client and SSR middleware
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — SERVER ONLY. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Timeweb Agent (primary product path) ---
# Referral / partner link from wm.timeweb.ru
NEXT_PUBLIC_TIMEWEB_PARTNER_URL=https://timeweb.cloud/?i=144829

# Platform deploy key: users paste the PUBLIC key in Timeweb when creating a VPS.
# Generate once:
#   ssh-keygen -t ed25519 -f wg-manager-deploy -C "wg-manager" -N ""
#   Public  → NEXT_PUBLIC_WG_SSH_PUBLIC_KEY (one line)
#   Private → WG_SSH_PRIVATE_KEY (use \n for newlines in .env)
NEXT_PUBLIC_WG_SSH_PUBLIC_KEY=
# Prefer an unencrypted deploy key: ssh-keygen -t ed25519 -N "" -f wg-manager-deploy
WG_SSH_PRIVATE_KEY=
# Only if the private key was created WITH a passphrase:
# WG_SSH_PRIVATE_KEY_PASSPHRASE=

# --- Timeweb Cloud API buy (demo only, hidden in UI by default) ---
# Set to "true" to show “Demo: API buy” on the dashboard (charges YOUR Timeweb balance).
NEXT_PUBLIC_ENABLE_TIMEWEB_API_BUY=false
TIMEWEB_CLOUD_API_TOKEN=
# TIMEWEB_LOCATION=nl-1
# TIMEWEB_PRESET_ID=
# TIMEWEB_OS_ID=

# --- RU Relay UI (hidden by default) ---
NEXT_PUBLIC_ENABLE_RU_RELAY=false

# --- Yandex Cloud CDN path (Client → Yandex CDN → Origin → Exit) ---
NEXT_PUBLIC_ENABLE_YANDEX_CDN=false
