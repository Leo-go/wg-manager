# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Get these from: Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Public Supabase project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anonymous (public) key — used by the browser client and SSR middleware
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — SERVER ONLY (setup API). Never commit real values.
# Bypasses RLS; required for POST /api/servers/[id]/setup to update installation status.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
