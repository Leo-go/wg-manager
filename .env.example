# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Get these from: Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Public Supabase project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anonymous (public) key — used by the browser client and SSR middleware
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — SERVER ONLY. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Timeweb Agent (primary product path) ---
# Referral / partner link from wm.timeweb.ru
NEXT_PUBLIC_TIMEWEB_PARTNER_URL=https://timeweb.cloud/?i=144829
NEXT_PUBLIC_TIMEWEB_DOMAINS_PARTNER_URL=https://timeweb.com/ru/services/domains/

# Platform deploy key: users paste the PUBLIC key in Timeweb when creating a VPS.
# Generate once:
#   ssh-keygen -t ed25519 -f wg-manager-deploy -C "wg-manager" -N ""
#   Public  → NEXT_PUBLIC_WG_SSH_PUBLIC_KEY (one line)
#   Private → WG_SSH_PRIVATE_KEY (use \n for newlines in .env)
NEXT_PUBLIC_WG_SSH_PUBLIC_KEY=
# Prefer an unencrypted deploy key: ssh-keygen -t ed25519 -N "" -f wg-manager-deploy
WG_SSH_PRIVATE_KEY=
# Only if the private key was created WITH a passphrase:
# WG_SSH_PRIVATE_KEY_PASSPHRASE=

# --- Timeweb Cloud API buy (demo only, hidden in UI by default) ---
# Set to "true" to show “Demo: API buy” on the dashboard (charges YOUR Timeweb balance).
NEXT_PUBLIC_ENABLE_TIMEWEB_API_BUY=false
TIMEWEB_CLOUD_API_TOKEN=
# TIMEWEB_LOCATION=nl-1
# TIMEWEB_PRESET_ID=
# TIMEWEB_OS_ID=

# --- RU Relay UI (hidden by default) ---
NEXT_PUBLIC_ENABLE_RU_RELAY=false

# --- Yandex Cloud CDN path (Client → Yandex CDN → Origin → Exit) ---
NEXT_PUBLIC_ENABLE_YANDEX_CDN=false

# Comma-separated emails allowed to open /dashboard/admin
ADMIN_EMAILS=

# Required on Vercel Production for /dashboard/admin user list (bypasses RLS).
# Supabase → Project Settings → API → service_role (secret). Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional support / legal contact shown in Terms & Privacy
# NEXT_PUBLIC_SUPPORT_EMAIL=support@wg-manager.ru

# --- Analytics ---
# Vercel Web Analytics: enable in Vercel → Project → Analytics (no extra env needed).
# Plausible custom events (partner_cta_opened, direct_setup_ready, …):
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-production-domain.com
# Optional self-hosted / proxy script URL (defaults to plausible.io):
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# --- Telegram bot (shared VPN for friends) ---
# Create via @BotFather, then set webhook after deploy:
#   GET /api/telegram/set-webhook?secret=YOUR_SETUP_SECRET
TELEGRAM_BOT_TOKEN=
# Supabase servers.id of the **exit** server with Yandex CDN ready (cdn_status=ready)
TELEGRAM_BOT_SERVER_ID=
# Root password for **CDN Origin** VPS (cdn_origin_ip), NOT exit / RU relay
TELEGRAM_BOT_SSH_PASSWORD=
# Optional instead of password:
# TELEGRAM_BOT_SSH_PRIVATE_KEY=
# TELEGRAM_BOT_SSH_PRIVATE_KEY_PASSPHRASE=
# TELEGRAM_BOT_SSH_USERNAME=root
# Comma-separated Telegram user IDs with admin commands
TELEGRAM_ADMIN_IDS=
# Payment instructions shown in /donate (SBP, card, etc.)
TELEGRAM_DONATE_DETAILS=Переведите 100 ₽ на СБП: +7 XXX XXX-XX-XX. В комментарии укажите ваш @username.
TELEGRAM_SUGGESTED_DONATION_RUB=100
TELEGRAM_MONTHLY_GOAL_RUB=2000
# Secret for set-webhook endpoint and optional webhook verification header
TELEGRAM_SETUP_SECRET=
TELEGRAM_WEBHOOK_SECRET=
# Telegram Stars per month (instant activation)
# TELEGRAM_STARS_AMOUNT=100
# Remind N days before subscription ends
# TELEGRAM_REMINDER_DAYS=3
# Vercel Cron auth for /api/cron/bot-subscriptions
# CRON_SECRET=
# Public site URL for "Create your VPN" button (production domain)
# NEXT_PUBLIC_SITE_URL=https://wg-manager.ru
